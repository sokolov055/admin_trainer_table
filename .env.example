# Адрес развёрнутого веб-приложения Apps Script (заканчивается на /exec).
# Взять: Apps Script → «Начать развёртывание» → «Веб-приложение», доступ «Все».
# Он же показывается в таблице: меню «Приложение» → «Проверить настройку».
VITE_API_URL=https://script.google.com/macros/s/ВАШ_ID_РАЗВЁРТЫВАНИЯ/exec
