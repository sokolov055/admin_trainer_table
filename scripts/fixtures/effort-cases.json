    { "name": "подпись прибавки", "fn": "suggestText", "args": [{ "weight": "62.5", "suggest": "easy" }, { "weight": "60" }], "expect": "+2,5 кг · было легко" },
    { "name": "подпись снижения", "fn": "suggestText", "args": [{ "weight": "57.5", "suggest": "short" }, { "weight": "60" }], "expect": "−2,5 кг · не добил повторы" },
